generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RolUsuario {
  ciudadano
  funcionario
}

enum EstadoSolicitud {
  pendiente
  en_revision
  resuelta
  rechazada
}

enum PrioridadSolicitud {
  baja
  media
  alta
}

model Usuario {
  id           String   @id @default(uuid())
  nombre       String
  rut          String
  email        String   @unique
  passwordHash String   @map("password_hash")
  region       String
  comuna       String
  rol          RolUsuario
  createdAt    DateTime @default(now()) @map("created_at")

  solicitudesCreadas Solicitud[]          @relation("SolicitudesCiudadano")
  solicitudesGestionadas Solicitud[]      @relation("SolicitudesFuncionario")
  documentosSubidos DocumentoSolicitud[]
  notificaciones Notificacion[]
  historialAcciones HistorialSolicitud[]
  mensajes MensajeSolicitud[]

  @@map("usuarios")
}

model Solicitud {
  id          String            @id @default(uuid())
  usuarioId   String            @map("usuario_id")
  funcionarioId String?          @map("funcionario_id")

  titulo      String
  categoria   String
  descripcion String
  direccion   String
  comuna      String
  estado      EstadoSolicitud   @default(pendiente)
  prioridad   PrioridadSolicitud @default(media)
  comentarioFuncionario String? @map("comentario_funcionario")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  usuario     Usuario @relation("SolicitudesCiudadano", fields: [usuarioId], references: [id])
  funcionario Usuario? @relation("SolicitudesFuncionario", fields: [funcionarioId], references: [id])

  documentos DocumentoSolicitud[]
  notificaciones Notificacion[]
  historial HistorialSolicitud[]
  mensajes MensajeSolicitud[]

  @@map("solicitudes")
}

model DocumentoSolicitud {
  id                  String   @id @default(uuid())
  solicitudId          String   @map("solicitud_id")
  subidoPorUsuarioId   String   @map("subido_por_usuario_id")

  nombreOriginal       String   @map("nombre_original")
  nombreAlmacenado     String   @map("nombre_almacenado")
  mimeType             String   @map("mime_type")
  sizeBytes            Int      @map("size_bytes")
  ruta                 String
  hashArchivo          String?  @map("hash_archivo")
  createdAt            DateTime @default(now()) @map("created_at")

  solicitud Solicitud @relation(fields: [solicitudId], references: [id], onDelete: Cascade)
  subidoPor Usuario @relation(fields: [subidoPorUsuarioId], references: [id])

  @@map("documentos_solicitud")
}

model Notificacion {
  id          String   @id @default(uuid())
  usuarioId   String   @map("usuario_id")
  solicitudId String?  @map("solicitud_id")

  titulo      String
  mensaje     String
  leida       Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  solicitud Solicitud? @relation(fields: [solicitudId], references: [id], onDelete: Cascade)

  @@map("notificaciones")
}

model HistorialSolicitud {
  id              String   @id @default(uuid())
  solicitudId      String   @map("solicitud_id")
  usuarioActorId   String   @map("usuario_actor_id")

  accion           String
  estadoAnterior   EstadoSolicitud? @map("estado_anterior")
  estadoNuevo      EstadoSolicitud? @map("estado_nuevo")
  comentario       String?
  createdAt        DateTime @default(now()) @map("created_at")

  solicitud Solicitud @relation(fields: [solicitudId], references: [id], onDelete: Cascade)
  usuarioActor Usuario @relation(fields: [usuarioActorId], references: [id])

  @@map("historial_solicitudes")
}

model MensajeSolicitud {
  id          String   @id @default(uuid())
  solicitudId String   @map("solicitud_id")
  emisorId    String   @map("emisor_id")

  mensaje     String
  leido       Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  solicitud Solicitud @relation(fields: [solicitudId], references: [id], onDelete: Cascade)
  emisor Usuario @relation(fields: [emisorId], references: [id])

  @@map("mensajes_solicitud")
}